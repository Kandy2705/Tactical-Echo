digraph combat_class_diagram {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  splines=ortho;
  concentrate=false;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  nodesep=0.9; ranksep=1.1;
  "IDamageable" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;interface&raquo;<br/><b>IDamageable</b></td></tr><tr><td align="left" cellpadding="5">+ IsAlive : bool<br align="left"/>+ ApplyDamage(DamageInfo)<br align="left"/></td></tr></table>>];
  "DamageInfo" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;readonly struct&raquo;<br/><b>DamageInfo</b></td></tr><tr><td align="left" cellpadding="5">Amount : float<br align="left"/>Point, Normal : Vector3<br align="left"/>Source : GameObject<br align="left"/></td></tr></table>>];
  "DamageSystem" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;static&raquo;<br/><b>DamageSystem</b></td></tr><tr><td align="left" cellpadding="5">+ TryApply(Collider, DamageInfo) : bool<br align="left"/></td></tr></table>>];
  "DamageHitZoneType" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>DamageHitZoneType</b></td></tr><tr><td align="left" cellpadding="5">Body, Head, Limb, ...<br align="left"/></td></tr></table>>];
  "DamageHitZone" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>DamageHitZone</b></td></tr><tr><td align="left" cellpadding="5">+ ZoneType : DamageHitZoneType<br align="left"/>+ DamageMultiplier : float<br align="left"/>+ IsCritical : bool<br align="left"/>+ Configure(type, multiplier)<br align="left"/></td></tr></table>>];
  "DamageFeedback" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;readonly struct&raquo;<br/><b>DamageFeedback</b></td></tr><tr><td align="left" cellpadding="5">Amount : float<br align="left"/>Point : Vector3<br align="left"/>ZoneType : DamageHitZoneType<br align="left"/>IsCritical : bool<br align="left"/></td></tr></table>>];
  "Health" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>Health</b></td></tr><tr><td align="left" cellpadding="5">+ Current, Max, Normalized : float<br align="left"/>+ IsAlive : bool<br align="left"/>+ ApplyDamage(DamageInfo)<br align="left"/></td></tr></table>>];
  "WeaponController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>WeaponController</b></td></tr><tr><td align="left" cellpadding="5">- definition : WeaponDefinition<br align="left"/>- audioProfile : WeaponAudioProfile<br align="left"/>- tracerPool : ShotTracer[]<br align="left"/>- onHitEffects : List&lt;OnHitStatusEffectRule&gt;<br align="left"/>+ event DamageFeedbackResolved : Action&lt;DamageFeedback&gt;<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Runtime : WeaponRuntime<br align="left"/>+ MagazineAmmo, ReserveAmmo : int<br align="left"/>+ IsReloading : bool<br align="left"/>+ Equip(WeaponDefinition) : bool<br align="left"/>+ TryFire(origin, dir, spreadMul, isAI) : bool<br align="left"/>+ TryBeginReload() : bool<br align="left"/>+ CompleteReload()<br align="left"/>+ CancelReload()<br align="left"/></td></tr></table>>];
  "WeaponDefinition" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, ScriptableObject&raquo;<br/><b>WeaponDefinition</b></td></tr><tr><td align="left" cellpadding="5">+ WeaponId, Damage, Range, FireRate<br align="left"/>+ FireMode : FireMode<br align="left"/>+ MagazineSize, ReloadTime<br align="left"/>+ BaseSpread, MaxSpread, SpreadPerShot,<br align="left"/>  SpreadRecoveryPerSecond, AimSpreadMultiplier<br align="left"/>+ NoiseRadius, NoiseIntensity<br align="left"/></td></tr></table>>];
  "WeaponRuntime" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>WeaponRuntime</b></td></tr><tr><td align="left" cellpadding="5">- magazineAmmo, reserveAmmo : int<br align="left"/>- currentSpread : float<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Definition : WeaponDefinition<br align="left"/>+ AmmoRatio : float<br align="left"/>+ CanFire(float) : bool<br align="left"/>+ TryConsumeShot(float) : bool<br align="left"/>+ GetEffectiveSpread(move01, aiming) : float<br align="left"/>+ TryBeginReload(float) : bool<br align="left"/>+ CompleteReload() : bool<br align="left"/>+ CancelReload()<br align="left"/></td></tr></table>>];
  "WeaponAudioProfile" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, ScriptableObject&raquo;<br/><b>WeaponAudioProfile</b></td></tr><tr><td align="left" cellpadding="5">+ ReloadStartClip, ReloadCompleteClip : AudioClip<br align="left"/>+ GetRandomFireClip() : AudioClip<br align="left"/></td></tr></table>>];
  "WeaponGripPoints" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>WeaponGripPoints</b></td></tr><tr><td align="left" cellpadding="5">+ RightHandGrip, LeftHandGrip, Muzzle : Transform<br align="left"/>+ Configure(right, left, muzzle)<br align="left"/></td></tr></table>>];
  "FireMode" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>FireMode</b></td></tr><tr><td align="left" cellpadding="5">Single, Burst, Automatic<br align="left"/></td></tr></table>>];
  "StatusEffectController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>StatusEffectController</b></td></tr><tr><td align="left" cellpadding="5">+ ActiveEffects : IReadOnlyList&lt;StatusEffectInstance&gt;<br align="left"/>+ Apply(StatusEffectDefinition)<br align="left"/>+ HasEffect(string, out StatusEffectInstance) : bool<br align="left"/></td></tr></table>>];
  "StatusEffectDefinition" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, ScriptableObject&raquo;<br/><b>StatusEffectDefinition</b></td></tr><tr><td align="left" cellpadding="5">+ EffectId : string<br align="left"/>+ Duration, DamagePerTick, TickInterval : float<br align="left"/>+ MaxStacks : int<br align="left"/>+ StackRule : StatusStackRule<br align="left"/>+ MoveSpeedMultiplier : float<br align="left"/></td></tr></table>>];
  "StatusStackRule" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>StatusStackRule</b></td></tr><tr><td align="left" cellpadding="5">Refresh, Stack, Ignore<br align="left"/></td></tr></table>>];
  "StatusEffectInstance" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>StatusEffectInstance</b></td></tr><tr><td align="left" cellpadding="5">+ Definition : StatusEffectDefinition<br align="left"/>+ StackCount : int<br align="left"/>+ Remaining : float<br align="left"/>+ IsExpired : bool<br align="left"/>+ Refresh(float)<br align="left"/>+ AddStack(float)<br align="left"/>+ TryConsumeTick(float, out float) : bool<br align="left"/></td></tr></table>>];
  "SurfaceImpactSystem" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>SurfaceImpactSystem</b></td></tr><tr><td align="left" cellpadding="5">- BulletDecal, BloodEmitter  // nested, private<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ HandleHit(RaycastHit, bool) : static<br align="left"/></td></tr></table>>];
  "SurfaceTypeOverride" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>SurfaceTypeOverride</b></td></tr><tr><td align="left" cellpadding="5">+ SurfaceType : ImpactSurfaceType<br align="left"/></td></tr></table>>];
  "ImpactSurfaceType" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>ImpactSurfaceType</b></td></tr><tr><td align="left" cellpadding="5">Default, Concrete, Metal, ...<br align="left"/></td></tr></table>>];
  "EnemyBrain / PlayerController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>EnemyBrain / PlayerController</b><br/><font point-size="10" color="#718096">AI, Character - use WeaponController/Health</font></td></tr></table>>];
  "WeaponHandIKController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>WeaponHandIKController</b><br/><font point-size="10" color="#718096">Animation/Runtime - uses WeaponGripPoints</font></td></tr></table>>];
  "Health" -> "IDamageable" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "DamageSystem" -> "IDamageable" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="ApplyDamage()", fontsize=10, fontcolor="#4a5568"];
  "DamageSystem" -> "DamageInfo" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "DamageHitZone" -> "DamageHitZoneType" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "DamageFeedback" -> "DamageHitZoneType" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "WeaponRuntime" -> "WeaponController" [dir=back, arrowtail=diamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="created internally", fontsize=10, fontcolor="#4a5568"];
  "WeaponController" -> "WeaponDefinition" [dir=forward, arrowhead=vee, style=solid, penwidth=1.0, color="#4a5568", xlabel="Definition", fontsize=10, fontcolor="#4a5568"];
  "WeaponAudioProfile" -> "WeaponController" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "WeaponGripPoints" -> "WeaponController" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="Muzzle", fontsize=10, fontcolor="#4a5568"];
  "WeaponController" -> "DamageSystem" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="TryFire -&gt; TryApply", fontsize=10, fontcolor="#4a5568"];
  "WeaponController" -> "SurfaceImpactSystem" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="HandleHit()", fontsize=10, fontcolor="#4a5568"];
  "WeaponController" -> "DamageFeedback" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="emits event", fontsize=10, fontcolor="#4a5568"];
  "WeaponController" -> "StatusEffectDefinition" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="onHitEffects", fontsize=10, fontcolor="#4a5568"];
  "WeaponDefinition" -> "FireMode" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "StatusEffectInstance" -> "StatusEffectController" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="activeEffects", fontsize=10, fontcolor="#4a5568"];
  "StatusEffectInstance" -> "StatusEffectDefinition" [dir=forward, arrowhead=vee, style=solid, penwidth=1.0, color="#4a5568"];
  "StatusEffectDefinition" -> "StatusStackRule" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "SurfaceImpactSystem" -> "SurfaceTypeOverride" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "SurfaceTypeOverride" -> "ImpactSurfaceType" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "EnemyBrain / PlayerController" -> "WeaponController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "EnemyBrain / PlayerController" -> "Health" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "WeaponHandIKController" -> "WeaponGripPoints" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
}
