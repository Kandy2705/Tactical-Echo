digraph camera_animation_class_diagram {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  splines=ortho;
  concentrate=false;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  nodesep=0.9; ranksep=1.1;
  "CameraMode" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>CameraMode</b></td></tr><tr><td align="left" cellpadding="5">Explore, Aim<br align="left"/></td></tr></table>>];
  "PlayerCameraController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>PlayerCameraController</b></td></tr><tr><td align="left" cellpadding="5">- obstruction : CameraObstructionHandler<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Mode : CameraMode<br align="left"/>+ PlanarForward, PlanarRight : Vector3<br align="left"/>+ Configure(target, PlayerInputReader)<br align="left"/>+ SetMode(CameraMode)<br align="left"/>+ AddRecoil(float)<br align="left"/>+ ShowHitMarker()<br align="left"/>+ SwitchShoulder()<br align="left"/></td></tr></table>>];
  "CameraObstructionHandler" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>CameraObstructionHandler</b></td></tr><tr><td align="left" cellpadding="5">+ FadedAlpha : float<br align="left"/>+ Configure(Transform target)<br align="left"/>+ ResolveCameraPosition(pivot, desired) : Vector3<br align="left"/></td></tr></table>>];
  "PlayerAnimationController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>PlayerAnimationController</b></td></tr><tr><td align="left" cellpadding="5">+ Configure(PlayerVisualController)<br align="left"/>+ SetLocomotion(move, speed01, sprint, aim)<br align="left"/>+ PlayFire()<br align="left"/>+ PlayReload()<br align="left"/>+ PlayDeath()<br align="left"/></td></tr></table>>];
  "EnemyAnimationController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>EnemyAnimationController</b></td></tr><tr><td align="left" cellpadding="5">+ IsDead : bool<br align="left"/>+ Configure(Animator)<br align="left"/>+ SetLocomotion(float speed01)<br align="left"/>+ SetAim(bool)<br align="left"/>+ PlayFire()<br align="left"/>+ PlayReload()<br align="left"/>+ PlayDeath()<br align="left"/>+ ClearDeath()<br align="left"/></td></tr></table>>];
  "DeathAnimationPlayer" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;static&raquo;<br/><b>DeathAnimationPlayer</b></td></tr><tr><td align="left" cellpadding="5">+ Play(Animator) : bool<br align="left"/>+ Stop(Animator)<br align="left"/></td></tr></table>>];
  "WeaponHandIKController" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>WeaponHandIKController</b></td></tr><tr><td align="left" cellpadding="5">- gripPoints : WeaponGripPoints<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Configure(WeaponGripPoints)<br align="left"/></td></tr></table>>];
  "PlayerVisualController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>PlayerVisualController</b><br/><font point-size="10" color="#718096">Character/Player</font></td></tr></table>>];
  "PlayerInputReader" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>PlayerInputReader</b><br/><font point-size="10" color="#718096">Character/Player</font></td></tr></table>>];
  "WeaponGripPoints" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>WeaponGripPoints</b><br/><font point-size="10" color="#718096">Combat/Weapons</font></td></tr></table>>];
  "IDamageable" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>IDamageable</b><br/><font point-size="10" color="#718096">Combat/Damage - interface</font></td></tr></table>>];
  "EnemyBrain" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>EnemyBrain</b><br/><font point-size="10" color="#718096">AI/Brain - calls PlayFire/PlayDeath/...</font></td></tr></table>>];
  "PlayerCameraController" -> "CameraMode" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096"];
  "CameraObstructionHandler" -> "PlayerCameraController" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="obstruction", fontsize=10, fontcolor="#4a5568"];
  "PlayerCameraController" -> "PlayerInputReader" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="Configure()", fontsize=10, fontcolor="#4a5568"];
  "PlayerCameraController" -> "IDamageable" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="crosshair raycast", fontsize=10, fontcolor="#4a5568"];
  "PlayerAnimationController" -> "PlayerVisualController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="Configure()", fontsize=10, fontcolor="#4a5568"];
  "EnemyBrain" -> "EnemyAnimationController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="SetAim/PlayFire/...", fontsize=10, fontcolor="#4a5568"];
  "PlayerAnimationController" -> "DeathAnimationPlayer" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="PlayDeath()", fontsize=10, fontcolor="#4a5568"];
  "EnemyAnimationController" -> "DeathAnimationPlayer" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="PlayDeath()", fontsize=10, fontcolor="#4a5568"];
  "WeaponGripPoints" -> "WeaponHandIKController" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="gripPoints", fontsize=10, fontcolor="#4a5568"];
}
