digraph ai_class_diagram {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  splines=ortho;
  concentrate=false;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  nodesep=0.9; ranksep=1.1;
  "EnemyBrain" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour - Facade&raquo;<br/><b>EnemyBrain</b></td></tr><tr><td align="left" cellpadding="5">- vision : VisionSensor<br align="left"/>- hearing : HearingSensor<br align="left"/>- memory : EnemyMemory<br align="left"/>- movement : EnemyMovement<br align="left"/>- weapon : WeaponController<br align="left"/>- health : Health<br align="left"/>- patrolRoute : PatrolRoute<br align="left"/>- animationController : EnemyAnimationController<br align="left"/>- tacticalEvaluator : TacticalEvaluator<br align="left"/>- coverEvaluator : CoverEvaluator<br align="left"/>- statusEffects : StatusEffectController<br align="left"/>- stateMachine : StateMachine&lt;EnemyStateId&gt;<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ CurrentState : EnemyStateId<br align="left"/>+ ConfigurePerception(vision, hearing, memory)<br align="left"/>+ ConfigureExecution(movement, weapon, animCtrl, ...)<br align="left"/>+ ConfigureDecision(tacticalEvaluator, coverEvaluator)<br align="left"/>+ ChangeState(EnemyStateId) : bool<br align="left"/>+ BuildTacticalContext() : TacticalContext<br align="left"/></td></tr></table>>];
  "ISensor" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;interface&raquo;<br/><b>ISensor</b></td></tr><tr><td align="left" cellpadding="5">+ TickSensor(float deltaTime)<br align="left"/></td></tr></table>>];
  "VisionSensor" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>VisionSensor</b></td></tr><tr><td align="left" cellpadding="5">- eyeOrigin, target : Transform<br align="left"/>- range : float<br align="left"/>- fieldOfView : float<br align="left"/>- scanInterval : float<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ HasLineOfSight : bool<br align="left"/>+ VisibleTarget : Transform<br align="left"/>+ Configure(...)<br align="left"/>+ SetTarget(Transform)<br align="left"/>+ TickSensor(float)<br align="left"/></td></tr></table>>];
  "HearingSensor" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>HearingSensor</b></td></tr><tr><td align="left" cellpadding="5">+ HasLastAudibleNoise : bool<br align="left"/>+ TickSensor(float)<br align="left"/>+ TryConsumeNoise(out NoiseEventData) : bool<br align="left"/></td></tr></table>>];
  "EnemyMemory" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>EnemyMemory</b></td></tr><tr><td align="left" cellpadding="5">- memoryDuration : float<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ HasKnownPosition : bool<br align="left"/>+ LastKnownPosition : Vector3<br align="left"/>+ Confidence : float<br align="left"/>+ RememberSeen(Vector3)<br align="left"/>+ RememberHeard(Vector3, float)<br align="left"/>+ TickMemory()<br align="left"/></td></tr></table>>];
  "EnemyMovement" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>EnemyMovement</b></td></tr><tr><td align="left" cellpadding="5">- navMeshSnapDistance : float<br align="left"/>- rotationSharpness : float<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ IsOnNavMesh : bool<br align="left"/>+ HasPath : bool<br align="left"/>+ SetDestination(Vector3, float) : bool<br align="left"/>+ Stop()<br align="left"/>+ FacePosition(Vector3)<br align="left"/>+ TrySnapToNavMesh(float) : bool<br align="left"/></td></tr></table>>];
  "CoverEvaluator" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>CoverEvaluator</b></td></tr><tr><td align="left" cellpadding="5">+ SetCoverPoints(IEnumerable&lt;CoverPoint&gt;)<br align="left"/>+ TryFindBestCover(pos, threat, out CoverPoint) : bool<br align="left"/></td></tr></table>>];
  "CoverPoint" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>CoverPoint</b></td></tr><tr><td align="left" cellpadding="5">+ Position : Vector3<br align="left"/>+ PeekPosition : Vector3<br align="left"/></td></tr></table>>];
  "PatrolRoute" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>PatrolRoute</b></td></tr><tr><td align="left" cellpadding="5">- waypoints : List&lt;Transform&gt;<br align="left"/>- loop : bool<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ HasWaypoints : bool<br align="left"/>+ TryGetWaypoint(int, out Vector3) : bool<br align="left"/>+ NextIndex(int) : int<br align="left"/>+ GetNearestIndex(Vector3) : int<br align="left"/></td></tr></table>>];
  "TacticalEvaluator" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed, MonoBehaviour&raquo;<br/><b>TacticalEvaluator</b></td></tr><tr><td align="left" cellpadding="5">- actions : List&lt;ITacticalAction&gt;<br align="left"/>- decisionInterval : float<br align="left"/>- switchThreshold : float<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Evaluate(TacticalContext, bool) : ITacticalAction<br align="left"/>+ LastDecision : TacticalActionId<br align="left"/>+ LastScores : IReadOnlyDictionary&lt;...&gt;<br align="left"/></td></tr></table>>];
  "ITacticalAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;interface&raquo;<br/><b>ITacticalAction</b></td></tr><tr><td align="left" cellpadding="5">+ Id : TacticalActionId<br align="left"/>+ CanExecute(TacticalContext) : bool<br align="left"/>+ Score(TacticalContext) : float<br align="left"/>+ Execute(EnemyBrain, TacticalContext)<br align="left"/></td></tr></table>>];
  "ShootAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>ShootAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// fires when LOS, ammo, not reloading<br align="left"/></td></tr></table>>];
  "AdvanceAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>AdvanceAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// closes distance when target too far<br align="left"/></td></tr></table>>];
  "TakeCoverAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>TakeCoverAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// runs to best CoverPoint<br align="left"/></td></tr></table>>];
  "RepositionAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>RepositionAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// sidesteps when too close<br align="left"/></td></tr></table>>];
  "ReloadAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>ReloadAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// reloads when empty/safe<br align="left"/></td></tr></table>>];
  "RetreatAction" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>RetreatAction</b></td></tr><tr><td align="left" cellpadding="5">+ CanExecute/Score/Execute<br align="left"/>// flees when health is low<br align="left"/></td></tr></table>>];
  "TacticalContext" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;struct&raquo;<br/><b>TacticalContext</b></td></tr><tr><td align="left" cellpadding="5">HasLineOfSight, TargetIsAlive, AmmoRatio,<br align="left"/>Threat, Suppression, CoverAvailable, ...<br align="left"/></td></tr></table>>];
  "EnemyStateBase" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;abstract&raquo;<br/><b>EnemyStateBase</b></td></tr><tr><td align="left" cellpadding="5"># Brain : EnemyBrain<br align="left"/></td></tr><tr><td align="left" cellpadding="5">+ Enter()<br align="left"/>+ Tick(float)<br align="left"/>+ Exit()<br align="left"/></td></tr></table>>];
  "PatrolState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>PatrolState</b></td></tr></table>>];
  "InvestigateState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>InvestigateState</b></td></tr></table>>];
  "CombatState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>CombatState</b></td></tr></table>>];
  "SearchState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>SearchState</b></td></tr></table>>];
  "RetreatState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>RetreatState</b></td></tr></table>>];
  "DeadState" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;sealed&raquo;<br/><b>DeadState</b></td></tr></table>>];
  "EnemyStateId" [shape=plain, label=<<table border="1" color="#2b6cb0" cellborder="0" cellspacing="0" bgcolor="white"><tr><td bgcolor="#eaf2fb" align="center" cellpadding="6">&laquo;enum&raquo;<br/><b>EnemyStateId</b></td></tr><tr><td align="left" cellpadding="5">Patrol, Investigate, Combat,<br align="left"/>Search, Retreat, Dead<br align="left"/></td></tr></table>>];
  "IState" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>IState</b><br/><font point-size="10" color="#718096">Core/StateMachine - interface</font></td></tr></table>>];
  "StateMachine<TStateId>" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>StateMachine&lt;TStateId&gt;</b><br/><font point-size="10" color="#718096">Core/StateMachine</font></td></tr></table>>];
  "WeaponController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>WeaponController</b><br/><font point-size="10" color="#718096">Combat/Weapons</font></td></tr></table>>];
  "Health" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>Health</b><br/><font point-size="10" color="#718096">Combat/Health</font></td></tr></table>>];
  "StatusEffectController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>StatusEffectController</b><br/><font point-size="10" color="#718096">Combat/StatusEffects</font></td></tr></table>>];
  "EnemyAnimationController" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>EnemyAnimationController</b><br/><font point-size="10" color="#718096">Animation/Runtime</font></td></tr></table>>];
  "NoiseEventHub" [shape=plain, label=<<table border="1" color="#a0aec0" cellborder="0" cellspacing="0" bgcolor="#f7fafc"><tr><td cellpadding="6">&laquo;external&raquo;<br/><b>NoiseEventHub</b><br/><font point-size="10" color="#718096">Core/Events - static</font></td></tr></table>>];
  "VisionSensor" -> "ISensor" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "HearingSensor" -> "ISensor" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "EnemyStateBase" -> "IState" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "PatrolState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "InvestigateState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "CombatState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "SearchState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "RetreatState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "DeadState" -> "EnemyStateBase" [dir=back, arrowtail=empty, style=solid, penwidth=1.2, color="#2d3748"];
  "ShootAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "AdvanceAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "TakeCoverAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "RepositionAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "ReloadAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "RetreatAction" -> "ITacticalAction" [dir=back, arrowtail=empty, style=dashed, penwidth=1.1, color="#2d3748"];
  "VisionSensor" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "HearingSensor" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "EnemyMemory" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "EnemyMovement" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "PatrolRoute" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "TacticalEvaluator" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "CoverEvaluator" -> "EnemyBrain" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0"];
  "StateMachine<TStateId>" -> "EnemyBrain" [dir=back, arrowtail=diamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="1 per enemy", fontsize=10, fontcolor="#4a5568"];
  "CoverPoint" -> "CoverEvaluator" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="scene list", fontsize=10, fontcolor="#4a5568"];
  "ITacticalAction" -> "TacticalEvaluator" [dir=back, arrowtail=odiamond, style=solid, penwidth=1.1, color="#2b6cb0", xlabel="6 actions", fontsize=10, fontcolor="#4a5568"];
  "EnemyBrain" -> "WeaponController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="Weapon", fontsize=10, fontcolor="#4a5568"];
  "EnemyBrain" -> "Health" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="Health", fontsize=10, fontcolor="#4a5568"];
  "EnemyBrain" -> "StatusEffectController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="StatusEffects", fontsize=10, fontcolor="#4a5568"];
  "EnemyBrain" -> "EnemyAnimationController" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="AnimationController", fontsize=10, fontcolor="#4a5568"];
  "EnemyStateBase" -> "EnemyBrain" [dir=forward, arrowhead=vee, style=solid, penwidth=1.0, color="#4a5568", xlabel="Brain", fontsize=10, fontcolor="#4a5568"];
  "CombatState" -> "TacticalEvaluator" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="Evaluate()", fontsize=10, fontcolor="#4a5568"];
  "HearingSensor" -> "NoiseEventHub" [dir=forward, arrowhead=vee, style=dashed, penwidth=1.0, color="#718096", xlabel="TryConsumeNoise", fontsize=10, fontcolor="#4a5568"];
}
